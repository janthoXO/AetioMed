meta {
  name: Generate Case (Continue Plan)
  type: http
  seq: 14
}

post {
  url: {{base_url}}/api/cases
  body: json
  auth: inherit
}

body:json {
  // Same jobId as "Generate Case (Plan Mode)" — reusing it after a
  // plan-mode stop is the one case a jobId may be resent for. `plan` is
  // the outline that call returned, pasted back verbatim or with only its
  // editable segments changed (fixed segments and the segment count must
  // stay untouched). This skips planning and generates the case from it.
  // `mode` is required with `plan`: the mode of the call that handed the
  // plan out, so the server knows which language the plan is in.
  // `userInstructions` is not allowed here (400): the plan absorbed them.
  {
    "jobId": "{{jobId}}",
    "diagnosis": "diabetes",
    "language": "de",
    "mode": "plan",
    "generationFlags": [
      "patient",
      "chiefComplaint",
      "anamnesis",
      "procedures"
    ],
    "plan": [
      { "fixed": false, "text": "" },
      { "fixed": true, "text": "## General" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Patient" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Chief complaint" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Anamnesis" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Procedures" },
      { "fixed": false, "text": "" }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
