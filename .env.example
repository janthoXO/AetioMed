# Copy to .env and adjust. The values below are a working minimum: a server
# with the HTTP API, talking to one LLM provider. The per-job label SSE
# stream and GET /api/graph are always on — see FEATURES below.

# Comma-separated feature flags. Each gates one thing in createApp():
#   REST       the HTTP API          (without it there is no way to submit a case)
#   NATS       the JetStream worker
#   DEBUG      cors + request logging on the REST app
#   ALLOW_LLMS per-request LLM selection (see ALLOWED_LLMS below)
FEATURES=REST

PORT=3030

# ─── LLM ──────────────────────────────────────────────────────────────────
# Required unless ALLOW_LLMS is set. Provider is ollama | google | openai
# (openai also serves any OpenAI-compatible endpoint via LLM_URL).
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite-preview
LLM_API_KEY=xzy
# LLM_URL=http://localhost:11434

# Optional per-role overrides. Each field (PROVIDER/MODEL/API_KEY/URL) falls
# back individually to the general LLM_* value above — so LLM_JUDGE_MODEL on
# its own means "same provider and key, bigger model for judging".
# NOTE: setting a role's _PROVIDER without its _MODEL fails at startup, since
# per-field fallback would otherwise resolve a model name from the wrong
# provider's namespace.
# LLM_GENERATOR_PROVIDER=ollama
# LLM_GENERATOR_MODEL=llama3.1
# LLM_GENERATOR_API_KEY=
# LLM_GENERATOR_URL=
# LLM_JUDGE_PROVIDER=google
# LLM_JUDGE_MODEL=gemini-2.0-flash
# LLM_TRANSLATOR_PROVIDER=ollama
# LLM_TRANSLATOR_MODEL=llama3.1

# Per-request LLM selection. With ALLOW_LLMS in FEATURES, no global LLM is
# configured and every request must supply its own llmConfig from this list.
# ALLOWED_LLMS=ollama:llama3.1,google:gemini-2.0-flash

# ─── Graph topology (compiled at boot, not per request) ───────────────────
# TRANSLATION_SANDWICH=true   # false/0 compiles the translation phases out
# PROCEDURE_PRESELECTION=false # true/1 picks categories before procedures

# ─── Language ─────────────────────────────────────────────────────────────
# Supported set; must include English. A request's language is validated
# against it (400 if outside). Startup fails if a listed language has no
# catalogue translations.
# LANGUAGES=English,German

# Resolve an omitted request language: offline n-gram detection, then
# optionally one LLM call. Both default to off; the LLM rung additionally
# requires the first.
# LANGUAGE_AUTO_DETECT=true
# LANGUAGE_DETECT_LLM_FALLBACK=true

# ─── Data ─────────────────────────────────────────────────────────────────
# CATALOG_DIR is deployer-owned read-only input; CACHE_DIR is generated
# output (the SQLite DB). Kept separate so mounting your own catalogues
# does not clobber the cache. Relative paths resolve against cwd.
# CATALOG_DIR=data
# CACHE_DIR=data/cache
# SYMPTOM_CACHE_TTL_DAYS=30
# MAX_CONTENT_PART_BYTES=5000000

# ─── NATS (only read when NATS is in FEATURES) ────────────────────────────
# NATS_URL=nats://localhost:4222
# NATS_USER=nats
# NATS_PASSWORD=nats

# ─── Concurrency ──────────────────────────────────────────────────────────
# Bounds in-flight generations identically over REST and NATS (one shared
# limiter, src/core/concurrency.ts). Excess requests queue; a queued job is
# still cancellable.
# MAX_CONCURRENT_GENERATIONS=4

# ─── OpenTelemetry ────────────────────────────────────────────────────────
# The operator-facing channel: one span per node (attributes only — nodeId,
# jobId, output size, provider/model, status) plus the node's output as a
# correlated log record (never a span attribute). Its own axis, independent
# of FEATURES — except FEATURES=DEBUG, used only to pick the exporter below.
# These are the standard OTel variables, not repo-specific ones. No new flag
# selects the exporter/processor pair; three modes, in priority order:
#   1. OTEL_SDK_DISABLED=true            -> nothing constructed at all.
#   2. an OTLP endpoint var set below     -> batch processors + OTLP export
#                                            (production; needs a collector
#                                            and/or backend listening there).
#   3. neither of the above, FEATURES=DEBUG set
#                                         -> immediate processors + console
#                                            exporters (zero-infrastructure
#                                            local dev — spans/logs print to
#                                            stdout as JSON).
#   Otherwise (no endpoint, no DEBUG)    -> nothing constructed. This is a
#                                            behaviour change: an unset
#                                            endpoint used to still build a
#                                            real SDK that tried (and failed)
#                                            to export to localhost:4318.
# OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_SERVICE_NAME=aetiomed
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
