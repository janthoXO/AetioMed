{
  "name": "aetiomed",
  "version": "1.0.0",
  "description": "LLM-based generator of synthetic medical cases for medical education: patient, chief complaint, anamnesis and blinded diagnostic workup from an ICD-11 code.",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "graph:export": "tsx scripts/exportGraphs.ts"
  },
  "keywords": [
    "medical-education",
    "synthetic-data",
    "medical-case-generator",
    "virtual-patient",
    "clinical-reasoning",
    "icd-11",
    "llm",
    "langgraph",
    "langchain",
    "ollama",
    "nats"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janthoXO/AetioMed.git"
  },
  "homepage": "https://github.com/janthoXO/AetioMed#readme",
  "bugs": "https://github.com/janthoXO/AetioMed/issues",
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.46",
    "@langchain/google": "^0.1.11",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.5",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/services": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "express": "^5.2.1",
    "js-yaml": "^5.1.0",
    "morgan": "^1.10.1",
    "tinyld": "^1.3.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.7.0",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.11"
  }
}
