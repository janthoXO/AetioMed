meta {
  name: Generate Case (Plan Mode)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/api/cases
  body: json
  auth: inherit
}

body:json {
  // Stops once the outline exists and hands it back in the request
  // language, instead of generating the case. The generator keeps nothing
  // of this call: the response's `context` (saved to the `context` var)
  // carries it, send it back with "Generate Case (Continue Plan)".
  {
    "jobId": "{{jobId}}",
    "diagnosis": "diabetes",
    "mode": "plan",
    "language": "de",
    "generationFlags": [
      "patient",
      "chiefComplaint",
      "anamnesis",
      "procedures"
    ]
  }
}

vars:post-response {
  context: res.body.context
}

settings {
  encodeUrl: true
  timeout: 0
}
