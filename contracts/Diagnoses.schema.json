{
  "title": "Diagnoses",
  "description": "GET /api/diagnosis; NATS catalog.diagnosis.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "icd": {
        "type": "string",
        "format": "icd",
        "pattern": "([0-9A-Z]{1,4})(\\.[A-Z0-9]{1,2})?"
      },
      "alternativeNames": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  }
}
