DEBUG=true
PORT=3030

FEATURES=PERSISTENCY,TRACING

LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite-preview
LLM_API_KEY=xzy

# Optional per-role overrides — each field (PROVIDER/MODEL/API_KEY/URL) falls
# back individually to the general LLM_* value above when unset.
# LLM_GENERATOR_PROVIDER=ollama
# LLM_GENERATOR_MODEL=llama3.1
# LLM_JUDGE_PROVIDER=google
# LLM_JUDGE_MODEL=gemini-2.0-flash
# LLM_TRANSLATOR_PROVIDER=ollama
# LLM_TRANSLATOR_MODEL=llama3.1

# Comma-separated deployment language set; must include English. Defaults to
# English,German when unset.
# LANGUAGES=English,German

# Auto-detect a request's language when it omits `language` (offline n-gram
# detector, then optionally an LLM fallback). Both default to off.
# LANGUAGE_AUTO_DETECT=true
# LANGUAGE_DETECT_LLM_FALLBACK=true

REDIS_URL=redis://localhost:6379
