meta {
  name: Regenerate Case
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/cases
  body: json
  auth: inherit
}

body:json {
  // Change an existing case or plan (#272). `context` from the last
  // response. Fresh jobId per call. Each entry: `path` (array, never a
  // string), optional `instruction` (refine; absent = reroll, same inputs
  // again), `alts` = the target unit's current parts' alt (unit and part
  // depth). Paths: ["outline"], ["outline", <heading segment index>],
  // ["patient"|"chiefComplaint"|"anamnesis"|"procedures"],
  // ["chiefComplaint", i], ["anamnesis", category(, i)],
  // ["procedures", code(, i)].
  // Reroll answers `done` with `pieces`. A refine reaching the outline
  // answers `planned`: a revised plan in plan review, else a `proposal`;
  // apply it with `{ "context": …, "accept": ["procedures"] }`.
  {
    "language": "de",
    "context": "{{context}}",
    "regenerate": [
      {
        "path": ["anamnesis", "Allergien"],
        "instruction": "Penicillinallergie ergänzen",
        "alts": ["Ich habe keine bekannten Allergien."]
      }
    ]
  }
}

vars:post-response {
  context: res.body.context
}

settings {
  encodeUrl: true
  timeout: 0
}
