meta {
  name: Generate Case (Continue Plan)
  type: http
  seq: 14
}

post {
  url: {{base_url}}/api/cases
  body: json
  auth: inherit
}

body:json {
  // Same jobId as "Generate Case (Plan Mode)" is fine (one reuse after a
  // plan-mode stop), a fresh one too. `context` is the opaque blob that call
  // returned, sent back unchanged: it carries the diagnosis, flags and the
  // plan, so none of those are resent (#272). `plan` is optional: the
  // returned plan, verbatim or with only its editable segments changed
  // (fixed segments and the segment count must stay untouched); absent, the
  // context's plan is used. Generates the case from it.
  {
    "jobId": "{{jobId}}",
    "language": "de",
    "context": "{{context}}",
    "plan": [
      { "fixed": false, "text": "" },
      { "fixed": true, "text": "## Allgemein\n\n…" },
      { "fixed": false, "text": "" },
      { "fixed": true, "text": "## Patient" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Hauptbeschwerde" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Anamnese" },
      { "fixed": false, "text": "…" },
      { "fixed": true, "text": "## Untersuchungen" },
      { "fixed": false, "text": "" }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
