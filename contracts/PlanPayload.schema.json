{
  "title": "PlanPayload",
  "description": "Plan-mode POST /api/cases 200; SSE `event: plan`; NATS cases.plan.<jobId>.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string"
    },
    "status": {
      "description": "Set on a terminal plan; absent on a normal-mode plan on the way.",
      "type": "string",
      "const": "planned"
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "plan"
      ]
    },
    "language": {
      "type": "string"
    },
    "plan": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fixed": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "fixed",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "description": "Opaque generation context (#272), on a plan-mode stop: send it back, with the possibly edited `plan`, to generate the case. Absent on a normal-mode plan: its case response carries the context.",
      "type": "string"
    }
  },
  "required": [
    "jobId",
    "mode",
    "language",
    "plan"
  ],
  "additionalProperties": false
}
