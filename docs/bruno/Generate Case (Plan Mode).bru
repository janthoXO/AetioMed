meta {
  name: Generate Case (Plan Mode)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/api/cases
  body: json
  auth: inherit
}

body:json {
  {
    "jobId": "{{jobId}}",
    "diagnosis": "diabetes",
    "mode": "plan",
    "language": "German",
    "generationFlags": [
      "patient",
      "chiefComplaint",
      "anamnesis",
      "procedures"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
